  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.9",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
